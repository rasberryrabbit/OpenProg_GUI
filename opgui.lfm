{ opgui.lfm
  Lazarus Form Resource
  GTK/Glade(opgui.glade) → Lazarus LFM 변환
  원본: Glade 3.40.0 / GTK+ 3.12
  변환 규칙:
    GtkWindow        → TForm
    GtkBox(vertical) → TPanel (alTop/alClient)
    GtkBox(horiz)    → TPanel (alLeft + 자식 배치)
    GtkNotebook      → TPageControl + TTabSheet
    GtkToolbar       → TToolBar
    GtkToolButton    → TToolButton
    GtkStatusbar     → TStatusBar
    GtkTextView      → TMemo
    GtkEntry         → TEdit
    GtkLabel         → TLabel
    GtkCheckButton   → TCheckBox
    GtkRadioButton   → TRadioButton (그룹: TRadioGroup 또는 같은 Parent)
    GtkComboBoxText  → TComboBox
    GtkSpinButton    → TSpinEdit
    GtkTreeView      → TListView
    GtkScrolledWindow→ (자식에 ScrollBars 속성 적용)
    GtkFrame         → TGroupBox
    GtkSeparator(Tool)→ TToolButton(tbsDivider)
    GtkButton        → TButton
    GtkMenuBar/MenuItem→ TMainMenu / TMenuItem
    GtkAdjustment    → Min/Max/Value 속성으로 인라인 처리
    icon-name        → 주석으로 보존 (런타임 아이콘 로딩 필요)
}

object window: TForm
  Left = 0
  Top = 0
  Caption = 'OPGUI'
  ClientWidth = 850
  ClientHeight = 250
  Position = poScreenCenter
  OnDestroy = FormDestroy
  object MainToolBar: TToolBar
    Left = 0
    Top = 0
    Width = 850
    Height = 32
    Align = alTop
    ButtonWidth = 32
    ButtonHeight = 32
    { icon: document-open-symbolic }
    object OPEN_T: TToolButton
      Name = 'OPEN_T'
      Caption = 'Open'
      Hint = 'Open file'
    end
    { icon: document-save-symbolic }
    object SAVE_T: TToolButton
      Name = 'SAVE_T'
      Caption = 'Save'
      Hint = 'Save file'
    end
    object ToolButton_Sep1: TToolButton
      Style = tbsDivider
    end
    { icon: read.png (custom resource) }
    object READ_T: TToolButton
      Name = 'READ_T'
      Caption = 'Read'
      Hint = 'Read device'
    end
    { icon: write.png (custom resource) }
    object WRITE_T: TToolButton
      Name = 'WRITE_T'
      Caption = 'Write'
      Hint = 'Write device'
    end
    object ToolButton_Sep2: TToolButton
      Style = tbsDivider
    end
    { icon: media-playback-stop-symbolic }
    object STOP_T: TToolButton
      Name = 'STOP_T'
      Caption = 'stop'
      Enabled = False
      Hint = 'Stop'
    end
    { icon: gtk-connect }
    object CONNECT_T: TToolButton
      Name = 'CONNECT_T'
      Caption = 'reconn'
      Hint = 'Reconnect'
    end
    { icon: help-browser-symbolic }
    object INFO_T: TToolButton
      Name = 'INFO_T'
      Caption = 'info'
      Hint = 'Info'
    end
  end

